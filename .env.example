# GhostRep local development
# Copy to .env and adjust. Never commit real keys.

# --- Application ---
APP_ENV=development
APP_MODE=real
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3100
SESSION_COOKIE=ghostrep_coach_athlete
# Session cookie: HttpOnly, SameSite=Lax, Secure only when FRONTEND_ORIGIN is https.
# Split frontend/API hosts will not send Lax cookies. Prefer one reverse-proxied origin.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8100
DATABASE_URL=sqlite:///./data-coach/ghostrep-coach.db
DATA_DIR=./data-coach
RETENTION_HOURS=24
RETAIN_RAW_VIDEO=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8100
NEXT_PUBLIC_APP_MODE=real
# Optional public PayPal Sandbox client ID for JS SDK v6. Prefer the backend
# /api/payments/config client_token when available. Never put the client secret here.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Zero-credit Meta controls (default: no paid calls) ---
# Workout and coaching inherit AI_PROVIDER when their own value is empty.
# Segmentation does not: it stays off until SEGMENTATION_PROVIDER is set.
AI_PROVIDER=local
WORKOUT_PROVIDER=local
COACHING_PROVIDER=local
SEGMENTATION_PROVIDER=none
SAM_INCLUDE_BARBELL=false
ENABLE_META_API=false
META_REQUIRE_EXPLICIT_APPROVAL=true
# No application call, spend, or completion-token caps by default.
# Optional operator controls, only if you choose to impose a limit:
# META_MAX_CALLS_PER_SESSION=100
# META_ESTIMATED_SPEND_LIMIT_USD=100
META_REQUEST_TIMEOUT_SECONDS=180
META_MAX_RETRIES=2
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1

# A key never starts a paid call. Live inference also needs ENABLE_META_API=true,
# the matching provider set to meta_live, and an explicit approval token.
# A local failure never falls through to a paid provider.

# --- Single merchant PayPal Sandbox only ---
# Obtain all three from ONE Sandbox REST app/business account. Never use live credentials.
# No PAYPAL_BASE_URL setting: server calls are pinned to api-m.sandbox.paypal.com.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
# Register an HTTPS webhook for this same Sandbox REST app, then paste its ID.
# Endpoint: https://YOUR_API/reviews/paypal/webhook (not the frontend port).
PAYPAL_WEBHOOK_ID=

# --- Coach access ---
# Run make coach-password. It prompts without echo and writes a scrypt hash to this copy’s .env.
# Share the password privately with the coach; never add it to a public judge guide.
COACH_PASSWORD_HASH=
COACH_DISPLAY_NAME=GhostRep Coach
# Simulator + fictional coach login are development-only, even if this is true in production.
COMMERCE_SIMULATOR_ENABLED=true

# Explicit owner approval is required before NEW live-call offers are enabled.
# Prices are integer USD cents. Purchased price/entitlement snapshots never change.
COACHING_PRICES_APPROVED=false
# COACHING_SESSION_PRICE_CENTS=1500
# COACHING_MONTH_PRICE_CENTS=7900
# COACHING_ADDITIONAL_PRICE_CENTS=1500
